{
  "name": "study-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "server:managed": "node server/scripts/processSupervisor.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:backup": "node server/db/backup.js create",
    "test:server": "node --import ./server/tests/setupEnv.js --test --test-concurrency=1 server/tests/**/*.test.js",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap sync",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  }
}
