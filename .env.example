# StudySync AI — Environment Configuration Template
# Copy to .env or .env.local for local development customizations
# IMPORTANT: In Vite frontend apps, only variables prefixed with VITE_ are exposed to the client bundle.
# Never place secret keys or sensitive backend credentials in frontend variables.

# Frontend Client Configuration (Vite)
VITE_APP_NAME=StudySync AI
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:3001/api

# Backend Server Configuration
# In production, PORT is often assigned by your cloud container runtime (e.g. 3001 or 8080)
PORT=3001
NODE_ENV=development

# CORS Origin: Allowed frontend origin. 
# In production, set to your exact domain (e.g., https://studysync.yourdomain.com).
# Wildcard '*' is strictly prohibited in production with credentials.
CORS_ORIGIN=http://localhost:5173

# Database Storage Path
# For SQLite, ensure this points to a persistent mounted volume path in production
# (e.g., /data/studysync.db or ./server/data/studysync.db)
DATABASE_PATH=./server/data/studysync.db

# Email OTP Delivery Provider Configuration (Zero-Cost / Opt-in)
# To enable real delivery of 6-digit registration OTP codes to user email inboxes:
# Option 1: Resend (Recommended, https://resend.com - Free tier: 3,000 emails/month)
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL=StudySync AI <onboarding@resend.dev>
# Option 2: SendGrid (https://sendgrid.com - Free tier: 100 emails/day)
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
# SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
# Option 3: Custom Webhook / Relay URL
# EMAIL_WEBHOOK_URL=https://your-webhook-endpoint.com/send-email
# EMAIL_WEBHOOK_TOKEN=your_optional_webhook_bearer_token

# Optional AI Provider Configuration (Zero-Cost / Opt-in)
# Set GEMINI_API_KEY to activate generative AI study tips and recommendations.
# If absent, StudySync AI operates 100% reliably using the deterministic, rule-based matching engine.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

