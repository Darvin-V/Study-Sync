# ==============================================================================
# StudySync AI — Production Environment Variables Template
#
# IMPORTANT SECURITY RULES:
# 1. Never commit real secret keys, API tokens, or production passwords to Git.
# 2. Configure these variables inside your hosting platform's secure environment settings
#    (e.g., Render Dashboard -> Environment Variables).
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Static Frontend Serving (Unified Full-Stack Deployment)
# Express server serves the compiled Vite bundle from dist/ alongside API on the same port
SERVE_STATIC=true

# Database Storage Path
# In Render Docker containers, points to the local database file path
DATABASE_PATH=/data/studysync.db

# Cross-Origin Resource Sharing (CORS) Configuration
# Set to your exact Render public HTTPS domain (e.g. https://studysync-ai.onrender.com)
# CRITICAL: Wildcards (*) are strictly forbidden in production when credentials are enabled.
CORS_ORIGIN=https://studysync-ai.onrender.com

# ------------------------------------------------------------------------------
# Zero-Cost SQLite Persistence via Litestream & Cloudflare R2 (10GB Free Storage)
# ------------------------------------------------------------------------------
# 1. Create a free bucket at https://dash.cloudflare.com -> R2 Object Storage
# 2. Under R2 Overview -> Manage R2 API Tokens -> Create API token (Object Read & Write)
# 3. Enter your values below:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=studysync-data

# ------------------------------------------------------------------------------
# Zero-Cost Email OTP Delivery via Resend (3,000 Free Emails/Month)
# ------------------------------------------------------------------------------
# 1. Create a free API key at https://resend.com -> API Keys
# 2. Enter your values below:
RESEND_API_KEY=
RESEND_FROM_EMAIL=StudySync AI <onboarding@resend.dev>

# Optional Alternative: SendGrid (100 emails/day free)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Optional AI Study Partner Recommendations (Google Gemini Free Tier)
# If omitted, StudySync operates 100% reliably using its deterministic rule-based matching engine.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
